# EDUS Citas - Credenciales (NO subir a Git)
# Copiar este archivo a .env y llenar con tus datos reales
# ⚠️ NUNCA compartir este archivo

# ── Credenciales EDUS ──
EDUS_CEDULA=tu_cedula_aqui
EDUS_CLAVE=tu_contraseña_aqui
SERVICIO=1
ESPECIALIDAD=1033
EXCLUIR_FECHAS=

# ── Bot de Telegram ──
# Token del bot (crear con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram
# Clave para cifrar las credenciales en la BD. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=genera_una_clave_fernet_aqui

# ── Modelo de visión IA (OpenAI-compatible) para resolver CAPTCHAs ──
# Opcional: si no se configura, el bot pedirá al usuario que lea el captcha
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=tu_api_key
# VISION_MODEL=gpt-4o-mini

# ── Programación de búsquedas ──
# Hora (hora Costa Rica) a la que se ejecuta la búsqueda programada.
# Los cupos se liberan a las 5:59 AM
HORA_BUSQUEDA=5
MINUTO_BUSQUEDA=59
# La búsqueda programada es encadenada: cuando termina una, arranca la
# siguiente de inmediato (con una pausa mínima RESPIRO_SEG), durante una
# VENTANA_BUSQUEDA_MIN total (o hasta que se reserve una cita)
VENTANA_BUSQUEDA_MIN=30
RESPIRO_SEG=3
# Segundos que espera el bot por una respuesta de captcha del usuario
CAPTCHA_TIMEOUT=60

# ── Docker (opcional, usado por docker-compose) ──
# Ruta de la BD y directorio de captchas dentro del contenedor (volúmenes)
# EDUS_DB_PATH=/app/data/edus_bot.db
# CAPTCHA_DIR=/app/data/captchas
# TZ=America/Costa_Rica
